# Copy to .env.local for local work. On Cloudflare, set the same names there.

# BUILD-TIME: names starting with NEXT_PUBLIC_ are baked into the build.
# On Cloudflare add these under Build > "Variables and secrets" (the BUILD section).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD
# Optional: Cloudflare Web Analytics token (cookie-free visitor counts). Leave empty to turn it off.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Non-secret settings (already in wrangler.jsonc for the deployed site).
ADMIN_EMAIL=you@example.com
EMAIL_FROM=PEACEMAGENTS <orders@your-domain.com>
PAYNOW_TEST_MODE=true

# RUNTIME SECRETS: add these as Worker secrets on Cloudflare. Never commit them.
ADMIN_PASSWORD=
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Only needed in test mode: the email you registered the Paynow account with.
PAYNOW_MERCHANT_EMAIL=
