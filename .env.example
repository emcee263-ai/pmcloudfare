# Copy to .env.local for local work, and set the same names in Cloudflare.
# With the Supabase values left empty the storefront runs on built-in sample
# products so you can work on the UI first.

# BUILD-TIME: values starting with NEXT_PUBLIC_ are baked into the build.
# On Cloudflare set these under "Build variables and secrets", not only as
# runtime variables, or the deployed site will run in sample-data mode.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RUNTIME SECRETS: set in Cloudflare as Worker secrets. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Payments (wired up in the payment phase)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
